AUTH_SECRET=
AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Optional. If omitted, local in-memory PGlite Postgres is used and seeded on boot.
# DATABASE_URL=postgres://fillslot:fillslot@localhost:5432/fillslot

# Stripe test mode (iDEAL + cards, EUR). If omitted, local demo books instantly without Checkout.
# Use the Secret key (sk_test_...), not a Restricted key (rk_test_...), unless that
# restricted key has Checkout Sessions Write and Connected accounts Write.
# stripe listen --forward-to localhost:3000/api/stripe/webhook
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Google sign-in (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Magic links. If omitted, links are logged and shown on /login in development.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Fillslot <noreply@fillslot.app>
