APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Pooled connection for the Next.js app (port 6543, add ?pgbouncer=true)
DATABASE_URL=postgres://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Session pooler for drizzle-kit migrate (port 5432). Use this if db.YOUR_PROJECT.supabase.co does not resolve.
DIRECT_URL=postgres://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Optional. Password for local demo accounts seeded into Supabase Auth.
# DEV_LOGIN_PASSWORD=fillslot-dev-local

# Stripe (test mode). If omitted, local demo books instantly without Checkout.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Email + password is enough for now. Google and Apple later, in the Supabase
# dashboard (Authentication > Providers), not in this file.
# Redirect URL: https://YOUR_PROJECT.supabase.co/auth/v1/callback
# App callback: http://localhost:3000/auth/callback
