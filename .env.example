AUTH_SECRET=
AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Optional. If omitted, local in-memory PGlite Postgres is used and seeded on boot.
# DATABASE_URL=postgres://fillslot:fillslot@localhost:5432/fillslot

# Stripe (test mode). If omitted, local demo books instantly without Checkout.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Google sign-in (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Magic links. If omitted, links are logged and shown on /login in development.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Fillslot <noreply@fillslot.app>
